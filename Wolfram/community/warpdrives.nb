              Automatic], 
             MenuItem["60", 
              KernelExecute[Image`InteractiveDump`rate$$ = 60], MenuEvaluator -> 
              Automatic]}]}, Selectable -> False},
       DynamicModuleValues:>{}],
      BoxForm`AnimatedImageTag[
      FrameRate -> 9, AnimationRunning -> True, AnimationRepetitions -> 
       DirectedInfinity[1]]]},
    {
     PaneBox[
      StyleBox["\<\"Figure 0. The hero animation.  A stylised spacecraft sits \
inside an Alcubierre bubble travelling at v = c.  The cyan grid shows how the \
warp field lifts and bunches the local coordinate mesh; the translucent blue \
sphere is the bubble surface; the magenta ring at the equator is where the \
exotic matter (negative energy density) lives.  Engine wake, starfield, and \
orbiting camera are just for atmosphere \[LongDash] the geometry, the grid, \
the ring and the spacecraft pose are computed from the analytic Alcubierre \
metric every frame.  The full-size version of the same animation is in \
Section 5b below.\"\>",
       StripOnInput->False,
       FontFamily->"Helvetica",
       FontSize->10,
       FontSlant->Italic],
      Alignment->Center,
      ImageSize->720]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Center}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.6}}}],
  "Column"]], "Output",
 CellMargins->{{20, 20}, {10, 14}},
 ShowCellLabel->False,
 TextAlignment->Center,ExpressionUUID->"cd27a615-0e99-4c1e-9633-8da81c9c55f6"],

Cell["Abstract", "Section",ExpressionUUID->"44fd0307-2d92-4854-aa50-a1075b8f29d1"],

Cell[TextData[{
 "Warp drives are the most science-fiction-sounding object in classical \
general relativity.  In Alcubierre's 1994 construction, a spacecraft sits \
inside a flat \"bubble\" of spacetime that contracts the geometry in front of \
it and expands the geometry behind it.  Locally the ship never moves faster \
than light \[LongDash] but the bubble itself can carry the ship across \
arbitrary coordinate distances in arbitrarily short coordinate times.  The \
catch is the stress-energy: the metric ",
 StyleBox["requires",
  FontSlant->Italic],
 " a region of negative energy density in the bubble wall.  This notebook \
ports the ",
 ButtonBox["WarpDrives Python package",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/WarpDrives"], None}],
 " into Wolfram Language packages and shows what symbolic-tensor machinery \
and ",
 StyleBox["DensityPlot", "Input"],
 " / ",
 StyleBox["NDSolve", "Input"],
 " buy you on this material: a working Einstein tensor in three lines, \
animated bubble fly-bys, geodesics that get swept up by the warp field, and \
side-by-side visualisations of the six metric families in the literature \
(Alcubierre 1994, Nat\[AAcute]rio 2002, Van Den Broeck 1999, White toroidal, \
Bobrick\[Dash]Martire 2021, Lentz 2021)."
}], "Text",ExpressionUUID->"c18adb57-5f53-4db9-b2fd-12d30cd420d7"],

Cell[TextData[{
 StyleBox["Status \[LongDash] hypothetical physics, not engineering.",
  FontWeight->Bold],
 "  Every metric discussed below is a ",
 StyleBox["mathematical",
  FontSlant->Italic],
 " solution of Einstein's field equations in the ",
 StyleBox["reverse",
  FontSlant->Italic],
 " sense: one prescribes a desired geometry ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Mu]", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "00a83f78-f376-4de2-ab85-8e9c1edcf506"],
 " and reads off the stress-energy tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    RowBox[{"\[Mu]", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "26f3a5e6-7fea-4542-b426-5a9927ad7719"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", 
    RowBox[{"\[Mu]", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "65ca4a35-1758-47c2-91d8-3387ae572299"],
 "/(8\[Pi]G) that would be required to source it.  No known substance \
produces the resulting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    RowBox[{"\[Mu]", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "1ea958f8-e937-4d2c-9dd9-85f47c1a2756"],
 ".  In particular, all superluminal warp metrics treated here (Alcubierre, \
Nat\[AAcute]rio, Van Den Broeck, White, and the superluminal Lentz branch) \
violate the null energy condition (NEC), so they require ",
 StyleBox["exotic matter",
  FontWeight->Bold],
 " \[LongDash] regions of negative energy density as measured by some \
observer.  Classical matter (dust, fluids, electromagnetic fields, scalar \
fields with canonical kinetic terms) cannot supply this; it is forbidden by \
every classical energy condition.  Quantum field theory does permit small, \
transient negative energy densities (the Casimir effect, squeezed vacuum \
states), but the Ford\[Dash]Roman quantum inequalities (1996) and Pfenning\
\[Dash]Ford's bubble-specific bound (1997) show that the negative-energy \
budget for an Alcubierre bubble of macroscopic size scales catastrophically: \
a bubble of radius ~100\[ThinSpace]m moving at ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "78f5b404-6912-4ed9-9060-ce8d9e7e88cc"],
 " = ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "357b437d-3827-4c5c-9953-951742d01922"],
 " requires a wall thinner than the Planck length and a total negative \
mass-energy of order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "65"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "a986bba8-cb96-4f9d-aa04-d96431a722e2"],
 " grams \[LongDash] of order a billion times the baryonic mass of the \
observable universe (~",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "56"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "2809f504-1826-4d5a-b830-3dd186ed4662"],
 " g), with the opposite sign.  Even granting the matter, superluminal \
bubbles develop horizons (Finazzi, Liberati & Barcel\[OAcute] 2009) that \
disconnect the ship from the front wall and exhibit semiclassical \
instabilities on timescales comparable to or shorter than the Planck time.  \
The genuinely subluminal proposal in this notebook (Bobrick\[Dash]Martire \
2021) is the only one that can satisfy the weak and null energy conditions, \
but it still demands astrophysical energy densities; the Lentz 2021 \
hyper-fast soliton was originally advertised as positive-energy, but \
subsequent analyses suggest the construction still violates the classical \
energy conditions.  Treat what follows as ",
 StyleBox["differential geometry of conceivable spacetimes",
  FontSlant->Italic],
 ", not a propulsion roadmap."
}], "Text",ExpressionUUID->"f7f75664-255c-4ad4-8d7b-966d7ede350e"],

Cell["Getting started", "Section",ExpressionUUID->"63acf1c1-1652-42c4-a96a-81699a23d1f4"],

Cell[TextData[{
 "Every figure and animation below is already rendered, so the post reads \
top-to-bottom in the browser \[LongDash] the animated GIFs embedded in each \
Output cell play directly in the Wolfram Community viewer.  If you'd like to \
rerun or tweak any of them locally, the Input cell above each figure contains \
the exact call.  Everything needed sits in a single self-contained package, \
",
 StyleBox["WarpBubbleSim.wl", "Input"],
 " (~30 KB, attached to this post).  Drop it next to the notebook, evaluate \
the cell below once, and every public symbol used later (",
 StyleBox["AlcubierreMetric", "Input"],
 ", ",
 StyleBox["EinsteinTensor", "Input"],
 ", ",
 StyleBox["CheckAllConditions", "Input"],
 ", ",
 StyleBox["IntegrateGeodesic", "Input"],
 ", \[Ellipsis]) becomes available:"
}], "Text",ExpressionUUID->"922f7766-f1a9-478a-b600-c06f4549af93"],

Cell["\<\
SetDirectory[NotebookDirectory[]];
Get[\"WarpBubbleSim.wl\"];   (* one file: 64 public functions + 2 options \
covering
                                 shape functions, six warp metrics,
                                 Christoffel/Riemann/Einstein tensors,
                                 ADM tools, energy conditions,
                                 geodesics, plotting helpers. *)\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"df9bfd44-ddf6-476f-97ea-20cea05fea20"],

Cell[TextData[{
 "Source repository (Wolfram + Python ports side by side): ",
 ButtonBox["github.com/mthiel74/WarpDrives",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/WarpDrives"], None}],
 "."
}], "Text",ExpressionUUID->"b84aac39-6550-412e-9095-42b49caf43b1"],

Cell["1. What is a warp drive?", "Section",ExpressionUUID->"24dce4ce-7b29-4529-b48c-f4b2dab4ce12"],

Cell[TextData[{
 "In special relativity nothing locally outpaces light, and that sets a hard \
ceiling on travel times: at half the speed of light, the nearest star is \
still nine years away.  General relativity is softer.  Once spacetime can \
curve, the question \"how fast did you travel?\" splits into two questions \
\[LongDash] how fast did you move with respect to the local geometry (still \
bounded by ",
 StyleBox["c",
  FontSlant->Italic],
 "), and how fast did the geometry itself rearrange around you?  Cosmology \
answers the second question routinely: distant galaxies recede from us \
superluminally because the universe is expanding, even though no individual \
galaxy moves faster than light through its own neighbourhood."
}], "Text",ExpressionUUID->"c1c78c55-efcd-4be6-ad0e-89f782e48121"],

Cell[TextData[{
 "Miguel Alcubierre asked in 1994 whether the same trick can be played \
locally and on demand.  The answer is yes: a sufficiently inventive metric \
can carry a flat-space \"bubble\" across the universe at any chosen ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "s"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "748d016f-ae2e-43ee-a13e-176dcac370a5"],
 " by contracting space in front of the bubble and expanding space behind it. \
 The price tag, as we'll see in Section 9, is steep.  But the geometry itself \
is surprisingly clean and admits a famously short closed form:"
}], "Text",ExpressionUUID->"e6795c54-a6f4-40d8-95a8-abef9786cbbe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["ds", "2"], "=", 
   RowBox[{"-", 
    SuperscriptBox["dt", "2"]}], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"dx", "-", 
      RowBox[{
       SubscriptBox["v", "s"], " ", 
       RowBox[{"f", "(", 
        SubscriptBox["r", "s"], ")"}], " ", "dt"}]}], ")"}], "2"], "+", 
   SuperscriptBox["dy", "2"], "+", 
   SuperscriptBox["dz", "2"]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"397e92eb-4243-47d0-bb48-a2f0bdfe009b"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "s"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "3dc5d41b-fbfb-492a-ae3c-b655ae0c99de"],
 " is the bubble's coordinate velocity, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "s"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "d0da39fa-74c0-4de4-8f2a-768e1297ddf3"],
 " its centre, with trajectory"
}], "Text",ExpressionUUID->"02f45f1f-4cb9-437b-affd-3c98b6bbbe1c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["x", "s"], "(", "t", ")", "=", 
   RowBox[{
    SubscriptBox["x", "0"], "+", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Integral]", "0"], "t"], " ", 
     RowBox[{
      SubscriptBox["v", "s"], "(", 
      RowBox[{"t", "'"}], ")"}], " ", 
     RowBox[{"d", 
      RowBox[{"t", "'"}]}]}]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"2f15abc9-3252-43f7-a834-524f332b30ce"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "s"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "4f452542-1002-400b-997a-b1cd9005393c"],
 " is the Euclidean distance from the bubble centre on the spatial slice"
}], "Text",ExpressionUUID->"025b470d-a199-4928-b989-9609688c4481"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["r", "s"], "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "s"]}], ")"}], "2"], "+", 
     SuperscriptBox["y", "2"], "+", 
     SuperscriptBox["z", "2"]}]]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"5d041502-1268-41ab-8d92-1a66f301a9c8"],

Cell[TextData[{
 "so a static observer at fixed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "x", ",", "y", ",", "z", ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "e12becfa-9755-47aa-ba4e-9a8b1d195488"],
 " sees ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "s"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "0e57aeda-7702-4f56-8eb8-91dae6f6c341"],
 " shrink linearly to zero as the bubble flies past, then grow back.  The \
shape function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", 
    SubscriptBox["r", "s"], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "032487f8-0135-4f16-a4e3-a1b2517d35b2"],
 " is what gives the bubble a finite extent; mathematically it can be any \
smooth scalar with the asymptotic behaviour"
}], "Text",ExpressionUUID->"694e7bf9-1509-44ea-b3b8-59eab768bf56"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"f", "(", "0", ")"}], "=", "1"}], ",", 
   "\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
   RowBox[{
    SubscriptBox["lim", 
     RowBox[{"r", "\[Rule]", "\[Infinity]"}]], " ", 
    RowBox[{"f", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"e4b1da50-70f5-4ec4-835a-2a4a4965d61d"],

Cell[TextData[{
 "Inside the bubble (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "s"], "\[LessEqual]", "R"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "a89b5446-6dd5-4bb1-b154-fd749190e228"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "\[TildeTilde]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "b6eebe8d-ad06-45ce-a1d9-cf8cc244b7a4"],
 ") the line element collapses to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["ds", "2"], "=", 
    RowBox[{"-", 
     SuperscriptBox["dt", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"dx", "-", 
        RowBox[{
         SubscriptBox["v", "s"], " ", "dt"}]}], ")"}], "2"], "+", 
     SuperscriptBox["dy", "2"], "+", 
     SuperscriptBox["dz", "2"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "5ec74717-884a-46db-88ce-c7a98f24472e"],
 ", which is just Minkowski space written in coordinates that are boosted at \
velocity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "s"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "2a86ad9c-4066-4d0b-8deb-f22a6a6fca17"],
 " \[LongDash] no curvature, no acceleration, the spacecraft sails along a \
straight worldline.  Outside the bubble (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "s"], ">>", "R"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "c1b56575-86a0-46fb-b536-7389cac3e029"],
 ") ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", 
    SubscriptBox["r", "s"], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "271ace5d-0557-4756-947e-cbb5b82463b4"],
 " is essentially zero and the metric is again Minkowski.  All the curvature \
and exotic-matter cost is concentrated in the ",
 StyleBox["wall region",
  FontSlant->Italic],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", 
    SubscriptBox["r", "s"], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "2945a8a6-e717-4334-90ad-359eaa1d1a1b"],
 " transitions from 1 to 0."
}], "Text",ExpressionUUID->"a1ec9e87-6fb3-4e6d-be69-6b9830ccd4ca"],

Cell["Alcubierre's original shape function is the Tanh sandwich", "Text",ExpressionUUID->"9d190c88-efb6-4204-b309-5ecc3d3d6898"],

Cell[BoxData[
 FormBox[
  RowBox[{"f", "(", "r", ")", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"tanh", "(", 
      RowBox[{"\[Sigma]", "(", 
       RowBox[{"r", "+", "R"}], ")"}], ")"}], "-", 
     RowBox[{"tanh", "(", 
      RowBox[{"\[Sigma]", "(", 
       RowBox[{"r", "-", "R"}], ")"}], ")"}]}], 
    RowBox[{"2", "tanh", "(", 
     RowBox[{"\[Sigma]", " ", "R"}], ")"}]]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"2f60ae2c-e555-42d5-9489-0497f527fa20"],

Cell[TextData[{
 "with two free parameters: ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "82192eeb-246d-4005-b310-63c3fdd275fe"],
 " sets the bubble radius, ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "10467c05-8289-4eb3-ab30-9f14c2da8fea"],
 " controls the wall thickness (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "\[Rule]", "\[Infinity]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "4c58be05-578b-4f4e-b662-8797cd159143"],
 " gives a hard step, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "\[Rule]", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "6d7eb5eb-7869-46cd-bfed-f73fb28c3ec5"],
 " smears the wall over all of space).  This is the canonical choice but \
other smooth profiles work too \[LongDash] a Gaussian, a compact-support \
polynomial, a smoothstep \[LongDash] each with a different trade-off between \
wall sharpness and energy density:"
}], "Text",ExpressionUUID->"c6221e7e-b827-42f8-aa91-ae09f28c3148"],

Cell["\<\
Plot[{TanhShape[r, 1, 8],
      GaussianShape[r, 1, 0.4],
      CompactPolynomialShape[r, 1, 0.4],
      SmoothStepShape[r, 1, 0.3]}, {r, 0, 2.5},
  PlotLegends -> {\"Tanh\", \"Gaussian\", \"Polynomial\", \"Smoothstep\"},
  Frame -> True, FrameLabel -> {\"r / R\", \"f(r)\"}]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"5107ae9f-f839-4d8c-b439-cabe1cf0015f"],

