  "Column"]], "Output",
 CellMargins->{{20, 20}, {10, 14}},
 ShowCellLabel->False,
 TextAlignment->Center,ExpressionUUID->"11093e31-db72-4839-9dc4-9183da91d6c7"],

Cell["4. Where space contracts, where space expands", "Section",ExpressionUUID->"5035aa50-43ba-4e46-8fee-2cc629b711ea"],

Cell[TextData[{
 "What does \"contraction in front, expansion behind\" mean operationally?  \
The ADM expansion scalar of the Eulerian observers measures it directly.  An \
Eulerian observer is one that moves with the spatial slices \[LongDash] their \
4-velocity is the unit normal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["n", "\[Mu]"], "=", 
    RowBox[{
     SuperscriptBox["\[Alpha]", 
      RowBox[{"-", "1"}]], 
     RowBox[{"(", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", 
        SuperscriptBox["\[Beta]", "i"]}]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "8d68fe49-4418-4923-9761-ba32c0dfa609"],
 ".  The extrinsic curvature of the slice measures how it bends inside \
spacetime as time flows:"
}], "Text",ExpressionUUID->"092c7052-3603-4762-9ec4-77288a56065b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["K", 
    RowBox[{"i", "j"}]], "=", 
   RowBox[{"-", 
    FractionBox["1", 
     RowBox[{"2", "\[Alpha]"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["D", "i"], " ", 
       SubscriptBox["\[Beta]", "j"]}], "+", 
      RowBox[{
       SubscriptBox["D", "j"], " ", 
       SubscriptBox["\[Beta]", "i"]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], " ", 
       SubscriptBox["\[Gamma]", 
        RowBox[{"i", "j"}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"e0135e7e-448b-4d2c-a6c3-125d76a73e98"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "i"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "123877f6-d134-4fd7-9dbe-7f6af7f704d3"],
 " the spatial covariant derivative on the slice (compatible with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "309c367a-edc5-4965-b53e-84e674f65da5"],
 ").  Its trace is the volume expansion rate seen by Eulerian observers:"
}], "Text",ExpressionUUID->"329e89bc-9366-4c6f-8e5f-ac0512a79d8b"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Theta]", "=", 
   RowBox[{
    SuperscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], " ", 
    SubscriptBox["K", 
     RowBox[{"i", "j"}]]}], "=", 
   RowBox[{"-", 
    SubscriptBox["D", "i"], " ", 
    SuperscriptBox["\[Beta]", "i"]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"a3644a2b-7080-47f5-bf4e-201c3116069b"],

Cell[TextData[{
 "For Alcubierre's metric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "27da67f8-e4bd-49ee-8d08-02cb2a8979b0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "j"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "def072a1-26d7-4646-9ae7-4fad390c9b85"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "i"], " ", 
    SuperscriptBox["\[Beta]", "i"], "=", 
    RowBox[{
     SubscriptBox["\[PartialD]", "i"], " ", 
     SuperscriptBox["\[Beta]", "i"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "bdb7f5dd-4e8d-45ab-ae26-4a6994dfc0d0"],
 " is just the ordinary divergence.  Plugging in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Beta]", "x"], "=", 
    RowBox[{"-", 
     SubscriptBox["v", "s"], " ", 
     RowBox[{"f", "(", 
      SubscriptBox["r", "s"], ")"}]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "68d3b7a4-06c9-4ea6-bf76-26d2edf479a2"],
 " and using the chain rule one gets a strikingly clean closed form:"
}], "Text",ExpressionUUID->"e723dd34-624b-45ac-8b83-196717bd7ea9"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Theta]", "=", 
   RowBox[{"-", "\[Del]", "\[CenterDot]", "\[Beta]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox["v", "s"], "(", 
      RowBox[{"x", "-", 
       SubscriptBox["x", "s"]}], ")"}], 
     SubscriptBox["r", "s"]], " ", 
    FractionBox["df", 
     RowBox[{"d", 
      SubscriptBox["r", "s"]}]]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"3d1401a8-2f07-45f6-ad80-4a3b6c66d9c5"],

Cell[TextData[{
 "For Alcubierre's bubble it's antisymmetric in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "-", 
    SubscriptBox["x", "s"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "5b5685e5-c1d9-4632-9cc5-bc6ece28e23a"],
 ": positive (volume expansion) behind the bubble, negative (volume \
contraction) in front, zero on the y-z plane through the centre.  Plotted on \
a slice at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "3bd7d3a6-05dc-41c4-ae41-c335900af64e"],
 " using a divergent colourmap:"
}], "Text",ExpressionUUID->"09cfd7ef-2ac9-4d68-bbb6-a6ef96b21802"],

Cell["\<\
DensityPlot[
  AlcubierreExpansionScalar[{1, 1, 8}, {0, x, y, 0}],
  {x, -2.5, 2.5}, {y, -2.5, 2.5},
  PlotPoints -> 220, ColorFunction -> \"RedBlueTones\",
  PlotLegends -> Automatic,
  Epilog -> {Black, Thick, Circle[{0, 0}, 1]}]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"adb8c4e0-1d69-48fd-970f-67ac95ba3ab5"],

