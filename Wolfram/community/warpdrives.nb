    {
     PaneBox[
      StyleBox["\<\"Figure 1. Eulerian energy density of an Alcubierre bubble \
(v=c, R=1, \[Sigma]=8).  Two depressions in the bubble wall \[LongDash] one \
in front of the ship, one behind \[LongDash] is where the exotic matter (\
\[Rho] < 0) must live.\"\>",
       StripOnInput->False,
       FontFamily->"Helvetica",
       FontSize->10,
       FontSlant->Italic],
      Alignment->Center,
      ImageSize->720]}
   },
   DefaultBaseStyle->"Column",
