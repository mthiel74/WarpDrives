             "], {{0, 356.}, {600., 0}}, {0, 255},
             ColorFunction->RGBColor],
            BoxForm`ImageTag[
            "Byte", ColorSpace -> "RGB", Interleaving -> True, Magnification -> 
             Automatic],
            Selectable->False],
           DefaultBaseStyle->"ImageGraphics",
           ImageSize->{600, 356},
           ImageSizeRaw->{600., 356.},
           PlotRange->{{0, 600.}, {0, 356.}}]}, Dynamic[Image`Utilities`i$$]], 
         PaneBox[
          DynamicBox[FEPrivate`Which[
            And[
            Image`InteractiveDump`play$$ === False, 
             Image`InteractiveDump`hover$$ === True], 
            PaneBox[
             DynamicBox[
              FEPrivate`FrontEndResource["FEBitmaps", "PlayButtonLargeHover"][
              Automatic]], ImageSize -> 40], 
            And[
            Image`InteractiveDump`play$$ === True, 
             Image`InteractiveDump`hover$$ === True], 
            PaneBox[
             DynamicBox[
              FEPrivate`FrontEndResource[
              "FEBitmaps", "PauseButtonLargeHover"][Automatic]], ImageSize -> 
             40], Image`InteractiveDump`play$$ === False, 
            PaneBox[
             DynamicBox[
              FEPrivate`FrontEndResource["FEBitmaps", "PlayButtonLarge"][
              Automatic]], ImageSize -> 40], True, ""],
           ImageSizeCache->{4., {0., 0.}}],
          Alignment->Center,
          ImageSize->{600, 356}]}],
        EventHandlerTag[{{"MouseClicked", 1} :> 
          FEPrivate`Set[Image`InteractiveDump`play$$, 
            Not[Image`InteractiveDump`play$$]], "MouseEntered" :> 
          FEPrivate`Set[Image`InteractiveDump`hover$$, True], "MouseExited" :> 
          FEPrivate`Set[Image`InteractiveDump`hover$$, False], Method -> 
          "Preemptive", PassEventsDown -> Automatic, PassEventsUp -> True}]],
       BaseStyle->{ContextMenu -> {
           MenuItem["Play/Pause", 
            KernelExecute[
            Image`InteractiveDump`play$$ = Not[Image`InteractiveDump`play$$]],
             MenuEvaluator -> Automatic], 
           MenuItem["Stop", 
            KernelExecute[
            Image`InteractiveDump`play$$ = False; Image`Utilities`i$$ = 1], 
            MenuEvaluator -> Automatic], Delimiter, 
           Menu["Frame Rate", {
             MenuItem["8", 
              KernelExecute[Image`InteractiveDump`rate$$ = 8], MenuEvaluator -> 
              Automatic], 
             MenuItem["16", 
              KernelExecute[Image`InteractiveDump`rate$$ = 16], MenuEvaluator -> 
              Automatic], 
             MenuItem["24", 
              KernelExecute[Image`InteractiveDump`rate$$ = 24], MenuEvaluator -> 
              Automatic], 
             MenuItem["30", 
              KernelExecute[Image`InteractiveDump`rate$$ = 30], MenuEvaluator -> 
              Automatic], 
             MenuItem["50", 
              KernelExecute[Image`InteractiveDump`rate$$ = 50], MenuEvaluator -> 
              Automatic], 
             MenuItem["60", 
              KernelExecute[Image`InteractiveDump`rate$$ = 60], MenuEvaluator -> 
              Automatic]}]}, Selectable -> False},
       DynamicModuleValues:>{}],
      BoxForm`AnimatedImageTag[
      FrameRate -> 7, AnimationRunning -> True, AnimationRepetitions -> 
       DirectedInfinity[1]]]},
    {
     PaneBox[
      StyleBox[
       TemplateBox[{
        "\"Figure 7. Eight initially stationary test particles overtaken by \
an Alcubierre bubble travelling left-to-right.  Each particle has spatial \
3-velocity \"", 
         "\"\\!\\(\\*SubscriptBox[\\(v\\), \
\\(s\\)]\\)f(\\!\\(\\*SubscriptBox[\\(r\\), \\(s\\)]\\))\"", 
         "\" \[LongDash] the Eulerian-observer law for \[Alpha]=1.  Particles \
near the axis (small |y|) get the deepest grip and are dragged fastest; \
off-axis particles are partly missed by the wall and barely move.  Black \
tails are trajectories so far; red dots are current positions; the background \
colourmap shows the expansion scalar \[Theta] (red = contraction in front of \
the bubble, blue = expansion behind), the front\[Dash]back asymmetry that \
makes the bubble carry the ship along.\""},
        "RowDefault"],
       StripOnInput->False,
       FontFamily->"Helvetica",
       FontSize->10,
       FontSlant->Italic],
      Alignment->Center,
      ImageSize->720]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Center}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.6}}}],
  "Column"]], "Output",
 CellMargins->{{20, 20}, {10, 14}},
 ShowCellLabel->False,
 TextAlignment->Center,ExpressionUUID->"776e0ad0-da10-4506-869f-62c6da38d60d"],

Cell[TextData[{
 "For a real geodesic integration (full 4-velocity, \
Christoffel-symbol-driven) the package ships ",
 StyleBox["IntegrateGeodesic", "Input"],
 " on top of ",
 StyleBox["NDSolve", "Input"],
 ".  The animation above uses the Eulerian-observer shortcut: each particle \
is advected by its instantaneous coordinate velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", 
    SuperscriptBox["x", "i"], "/", "dt"}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",ExpressionUUID->
  "62698aef-d142-4528-99ac-78cd2e7b8967"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox["\[Beta]", "i"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "357921c8-0c15-42f3-9860-019df6c56d14"],
 ", which is the spatial 3-velocity of an observer whose 4-velocity is the \
unit normal to the slice.  This is a 3-velocity shortcut, not a full timelike \
geodesic, but it captures exactly the bubble's drag on test particles for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "8bfcf2a1-4e57-4b8b-8b5c-94470432d1cc"],
 "."
}], "Text",ExpressionUUID->"a3b7200d-12a7-43d2-9083-933a42f8cac4"],

Cell["8. Six warp drives in one figure", "Section",ExpressionUUID->"8985c105-63f0-459f-88db-c99ba1ed0bac"],

Cell[TextData[{
 "Alcubierre's drive is the simplest member of a larger family of geometries. \
 Six are currently of interest in the literature, each addressing a specific \
physical objection to its predecessor:\n",
 "\[Bullet] ",
 StyleBox["Alcubierre 1994",
  FontWeight->Bold],
 " \[LongDash] the original.  Negative energy required.\n",
 "\[Bullet] ",
 StyleBox["Nat\[AAcute]rio 2002",
  FontWeight->Bold],
 " \[LongDash] same speed, but constructed so the shift vector is \
divergence-free.  No volume expansion or contraction \[LongDash] the bubble \
\"slides\" through space rather than \"pushing\" it.  Negative energy is \
still required (NEC violation does not depend on the divergence of the \
shift).\n",
 "\[Bullet] ",
 StyleBox["Van Den Broeck 1999",
  FontWeight->Bold],
 " \[LongDash] adds a \"pocket\" interior so the external bubble radius can \
be microscopic while the inside stays habitable.  Energy scales with the \
(small) external radius.\n",
 "\[Bullet] ",
 StyleBox["White toroidal",
  FontWeight->Bold],
 " \[LongDash] heuristic NASA construction with the exotic matter distributed \
on a torus rather than a sphere.\n",
 "\[Bullet] ",
 StyleBox["Bobrick\[Dash]Martire 2021",
  FontWeight->Bold],
 " \[LongDash] the breakthrough: subluminal warp drives can be sourced by ",
 StyleBox["positive",
  FontSlant->Italic],
 " energy.  The trade-off is the speed limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "s"], "<", "c"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "21020ec9-bb80-42bf-a166-6ca0f798665f"],
 ".\n",
 "\[Bullet] ",
 StyleBox["Lentz 2021",
  FontWeight->Bold],
 " \[LongDash] soliton drive sourced by Einstein\[Dash]Maxwell\[Dash]plasma \
fields, claimed positive-energy.  Subsequent analysis suggests the original \
construction needed exotic matter after all, but the soliton family is still \
actively studied."
}], "Text",ExpressionUUID->"67c4d38b-77c4-4b67-83d4-f4f0c127f6d0"],

Cell["\<\
The six metric families are mathematically distinct even though they share \
the same broad qualitative picture.  In ADM form, each one differs only in \
the choice of lapse, shift, and spatial metric:\
\>", "Text",ExpressionUUID->"36c0f4a4-3b24-4eff-a7f1-af94a853c8e4"],

Cell[TextData[{
 "\[Bullet] ",
 StyleBox["Alcubierre",
  FontWeight->Bold],
 " takes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "b811ca6e-1de9-4b92-946a-79a747cd2f72"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "j"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "185a175d-529c-4d74-ae12-3e6f2fea93a0"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Beta]", "i"], "=", 
    RowBox[{"(", 
     RowBox[{"-", 
      SubscriptBox["v", "s"], " ", 
      RowBox[{"f", "(", 
       SubscriptBox["r", "s"], ")"}]}], ",", " ", "0", ",", " ", "0", ")"}]}],
    TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "3edb176e-6a49-474d-8e59-225ad597a67f"],
 ", as we've seen.  The shift has non-zero divergence (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", "\[CenterDot]", "\[Beta]", "\[NotEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "15294e5b-05ef-4e8f-a65c-7cfe7a638e56"],
 ") so spacetime expands and contracts."
}], "Text",ExpressionUUID->"2b29bbce-1e31-4717-a367-8e557e2dc725"],

Cell[TextData[{
 "\[Bullet] ",
 StyleBox["Nat\[AAcute]rio",
  FontWeight->Bold],
 " keeps the same flat ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "18fb3570-af5e-4f11-a9b4-f51e902e632c"],
 " and unit lapse but demands"
}], "Text",ExpressionUUID->"ad2c240b-37f1-4cd5-99d2-197f8c891ad1"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Del]", "\[CenterDot]", "\[Beta]", "=", "0"}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"08f7965a-974a-4d5c-8482-a5e34f831116"],

Cell[TextData[{
 "so the Eulerian observers see ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "=", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "64d967ad-bfc4-4410-98c1-fb43cd4ac415"],
 " everywhere \[LongDash] no expansion, no contraction, just shear.  This is \
enforced by writing the shift as the curl of a vector potential,"
}], "Text",ExpressionUUID->"c3781f63-c130-454e-a1ee-b1834f88726b"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Beta]", "=", 
   RowBox[{"\[Del]", "\[Times]", "A"}]}], TraditionalForm]], "DisplayFormula",\

 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"ab5275af-f4cd-476b-9246-0e65ef3bfcaa"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "17b559fc-c298-4e34-8707-86baf4d858cf"],
 " chosen so that the bubble moves at the desired velocity.  The bubble in \
this picture \"slides through\" space rather than \"pushing\" space."
}], "Text",ExpressionUUID->"ad7a6364-8a9a-445d-a083-88a0add0efe7"],

Cell[TextData[{
 "\[Bullet] ",
 StyleBox["Van Den Broeck",
  FontWeight->Bold],
 " keeps Alcubierre's shift but multiplies the spatial metric by a \
position-dependent conformal factor:"
}], "Text",ExpressionUUID->"af5c68e9-c462-4068-bed6-cc5f64b8c44f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["ds", "2"], "=", 
   RowBox[{"-", 
    SuperscriptBox["dt", "2"]}], "+", 
   SuperscriptBox[
    RowBox[{"B", "(", 
     SubscriptBox["r", "s"], ")"}], "2"], " ", 
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"dx", "-", 
        RowBox[{
         SubscriptBox["v", "s"], " ", 
         RowBox[{"f", "(", 
          SubscriptBox["r", "s"], ")"}], " ", "dt"}]}], ")"}], "2"], "+", 
     SuperscriptBox["dy", "2"], "+", 
     SuperscriptBox["dz", "2"]}], "]"}]}], TraditionalForm]], "DisplayFormula",\

 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"52e33906-2ab3-49bf-9ed2-a63c2fd0cff9"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "(", 
    SubscriptBox["r", "s"], ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "480d1f57-a28a-431b-a12d-be03fbe6e5dd"],
 " chosen to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "\[GreaterTilde]", " ", 
    SubscriptBox["B", "int"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "2d2d28ce-5746-4f9e-90ca-c3a8af0df2f8"],
 " inside an inner radius ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "int"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "5a13b772-d85f-4c7d-8caa-b1fe13a1ba99"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "\[TildeTilde]", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "320e9c3a-dfa7-48e4-a2e6-4ee22ede74c3"],
 " outside an outer radius ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "ext"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "79368b3c-9e2f-4c10-81f8-8fa5640f4626"],
 ".  This gives the bubble a microscopic external footprint while preserving \
a macroscopic interior \[LongDash] and crucially the energy scales with the \
small ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "ext"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "700f3245-aa35-4271-8fcd-d6fd346bfa06"],
 " not the large ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "int"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "909cdd14-7774-4094-8bed-6e5515a6c04b"],
 ":"
}], "Text",ExpressionUUID->"d511f8b6-23c6-4534-b706-eb5f4f152483"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["E", "VdB"], "\[Proportional]", 
   SubscriptBox["R", "ext"], ",", "\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
   SubscriptBox["V", "interior"], "\[Proportional]", 
   RowBox[{
    SuperscriptBox["B", "3"], " ", 
    SuperscriptBox[
     SubscriptBox["R", "int"], "3"]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"3a5a5e0e-cd79-418d-826c-c38a911beb17"],

Cell[TextData[{
 "\[Bullet] ",
 StyleBox["White toroidal",
  FontWeight->Bold],
 " replaces the spherical distance ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "s"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "33972385-3c8e-4437-ad69-3668638af055"],
 " with the Euclidean distance to the surface of a torus,"
}], "Text",ExpressionUUID->"f4b86d32-81bd-42b6-90e8-2de16411116e"],

Cell[BoxData[
 FormBox[
  RowBox[{"d", "(", 
   RowBox[{"x", ",", "y", ",", "z"}], ")", "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox["y", "2"], "+", 
           SuperscriptBox["z", "2"]}]], "-", 
         SubscriptBox["R", "major"]}], ")"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "s"]}], ")"}], "2"]}]], "-", 
    SubscriptBox["R", "minor"]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"5f47bd86-79fe-4643-92f1-a1c143f62162"],

Cell[TextData[{
 "so the exotic-matter wall lies on a tube of major radius ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "major"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "cec59721-8842-47e9-8e2f-a0545b775212"],
 " and minor radius ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "minor"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "0be6903d-fb63-491b-ae10-42251179e929"],
 ", concentrating the negative energy into a doughnut rather than a sphere."
}], "Text",ExpressionUUID->"29830152-92ea-47cd-b9c3-dbe80f6fcb09"],

Cell[TextData[{
 "\[Bullet] ",
 StyleBox["Bobrick\[Dash]Martire",
  FontWeight->Bold],
 " is the most physically interesting: localise the metric deviation in a \
thin spherical shell ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "in"], "<", "r", "<", 
    SubscriptBox["R", "out"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "bc0e26d5-2d0b-4c2c-a871-bf385095c824"],
 " using"
}], "Text",ExpressionUUID->"d6c85e9c-1a7a-49d4-8384-0e257cecdcbd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Chi]", "(", "r", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"tanh", "(", 
       RowBox[{"\[Sigma]", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["R", "in"]}], ")"}], ")"}]}], ")"}], " ", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"tanh", "(", 
       RowBox[{"\[Sigma]", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["R", "out"]}], ")"}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"47b1eec2-c919-4935-a59e-295697f958fc"],

Cell["\<\
and pick the shell-region lapse, shift, and spatial-metric perturbations to \
satisfy the energy conditions.  The key result is:\
\>", "Text",ExpressionUUID->"22350c9a-0cf4-406d-9c22-a87421cb3474"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["v", "s"], "<", "1", 
   "\[ThickSpace]\[ThickSpace]\[ThickSpace]", "\[Implies]", 
   "\[ThickSpace]\[ThickSpace]", 
   RowBox[{"WEC", " ", "satisfiable"}]}], TraditionalForm]], "DisplayFormula",\

 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"992160b4-f4d2-42bc-8112-4b21366a9e73"],

Cell["\<\
i.e. once the bubble is forced to move slower than light, ordinary \
positive-energy matter is enough to source it.\
\>", "Text",ExpressionUUID->"31e4a29c-969d-4b85-8eeb-84d992958692"],

Cell[TextData[{
 "\[Bullet] ",
 StyleBox["Lentz",
  FontWeight->Bold],
 " uses a soliton ansatz with hyperbolic relations between lapse and shift, \
built from"
}], "Text",ExpressionUUID->"33926128-880a-4594-8e4a-aaa996b967ab"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Phi]", "(", "r", ")"}], "=", 
   RowBox[{"sech", "(", 
    FractionBox["r", "R"], ")"}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"b69a3272-9eb6-49d4-92c5-5dc22682515a"],

Cell["\<\
and tied to an electromagnetic / plasma source via Einstein\[Dash]Maxwell\
\[Dash]plasma equations.  Whether the original construction is genuinely \
positive-energy is debated in the literature.\
\>", "Text",ExpressionUUID->"dfef0863-5b50-4027-a689-089a94981021"],

Cell[TextData[{
 "Each lives in ",
 StyleBox["WarpBubbleSim.wl", "Input"],
 " under the obvious function name (",
 StyleBox["AlcubierreMetric", "Input"],
 ", ",
 StyleBox["NatarioMetric", "Input"],
 ", ",
 StyleBox["VanDenBroeckMetric", "Input"],
 ", ",
 StyleBox["WhiteToroidalMetric", "Input"],
 ", ",
 StyleBox["BobrickMartireMetric", "Input"],
 ", ",
 StyleBox["LentzMetric", "Input"],
 "), all returning a 4\[Times]4 symbolic ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Mu]", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "7658c5a9-c677-4e99-899b-db86e70ba171"],
 ".  The figure below visualises the geometric \"footprint\" of each \
\[LongDash] for Alcubierre, the analytic \[Rho]; for the others, an analogous \
shape-function-driven proxy."
}], "Text",ExpressionUUID->"564caf23-1312-44ac-a819-c38c8d8ed58b"],

Cell["PlotMetricComparison[Range -> 2.5, Grid -> 90]", "Input",
 CellTags->"runnable",ExpressionUUID->"3cd04bf5-149a-4c86-aacc-93eb8eb106f7"],

