Cell[TextData[{
 "Each profile satisfies the same boundary conditions \[LongDash] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "0", ")", "=", "1"}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",ExpressionUUID->
  "dfabe116-f057-48e3-a5ef-97809b84e558"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "\[Infinity]", ")", "=", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "e07dd45c-23b8-4527-aa6e-e23a02c182ab"],
 " \[LongDash] but they differ in how sharp the wall is and whether the \
support is compact.  Sharper walls localise the exotic matter into a thinner \
shell at the cost of larger derivatives, which means more curvature, which \
means more energy.  This is the first hint that the energy bill of a warp \
drive is essentially set by the ",
 StyleBox["geometry of the wall",
  FontSlant->Italic],
 ", not by the bubble's velocity."
}], "Text",ExpressionUUID->"2688535f-b88d-4c3f-803b-75b8b12667e8"],

Cell["2. The metric in ADM form", "Section",ExpressionUUID->"5582c23a-1046-414c-b5ee-cf293514a18c"],

Cell[TextData[{
 "Every warp drive in the literature is most natural in the 3+1 ADM \
formulation.  Foliate spacetime into spatial slices labelled by ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "18a150c3-dbaf-42e6-aef9-01e162347994"],
 "; on each slice keep the spatial metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "e831965a-9be8-4735-bb8c-420d50167499"],
 "; relate proper time on neighbouring slices by the lapse ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "08acf434-38a6-4195-831c-6b22781c1be1"],
 "; relate spatial coordinates between slices by the shift vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "i"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "1cfa6625-b97e-4bb8-bdda-ef60021fd42b"],
 ".  The line element splits into a temporal-distance piece and a \
spatial-displacement piece:"
}], "Text",ExpressionUUID->"47816516-363a-46b3-9453-2a2fbab539bb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["ds", "2"], "=", 
   RowBox[{"-", 
    SuperscriptBox["\[Alpha]", "2"], " ", 
    SuperscriptBox["dt", "2"]}], "+", 
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["dx", "i"], "+", 
     RowBox[{
      SuperscriptBox["\[Beta]", "i"], "dt"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["dx", "j"], "+", 
     RowBox[{
      SuperscriptBox["\[Beta]", "j"], "dt"}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"644318a8-63db-4185-bab8-17305846a3de"],

Cell["\<\
Reading off matrix entries gives the standard 3+1 decomposition of the \
4-metric:\
\>", "Text",ExpressionUUID->"2b1a8043-96d6-48dd-9dbb-68277dcae9d9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", "00"], "=", 
   RowBox[{"-", 
    SuperscriptBox["\[Alpha]", "2"], "+", 
    RowBox[{
     SubscriptBox["\[Beta]", "i"], " ", 
     SuperscriptBox["\[Beta]", "i"]}]}]}], TraditionalForm]], "DisplayFormula",\

 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"fd303275-e151-44e1-b43a-de56797ca719"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"0", "i"}]], "=", 
   SubscriptBox["\[Beta]", "i"], "=", 
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], " ", 
    SuperscriptBox["\[Beta]", "j"]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"d6e5a37c-9713-45cc-86e2-4f1542c9a31e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", "ij"], "=", 
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"15dc5c2c-3982-4490-9e9a-5395b3200e62"],

Cell[TextData[{
 "with summation convention on the spatial indices ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ",", "j", "\[Element]", 
    RowBox[{"{", "1", ",", "2", ",", "3", "}"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "84b04467-e383-4222-984b-398991437046"],
 " and the spatial-metric raise/lower ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "i"], "=", 
    RowBox[{
     SubscriptBox["\[Gamma]", 
      RowBox[{"i", "j"}]], " ", 
     SuperscriptBox["\[Beta]", "j"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "f3130d63-f827-479c-9f37-51dd2967898d"],
 ".  The inverse 4-metric has a similarly clean form: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "00"], "=", 
    RowBox[{"-", 
     SuperscriptBox["\[Alpha]", 
      RowBox[{"-", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "4a841a53-8d75-418b-a390-3dcdfdf7f54b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"0", "i"}]], "=", 
    RowBox[{
     SuperscriptBox["\[Beta]", "i"], 
     SuperscriptBox["\[Alpha]", 
      RowBox[{"-", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "1277bc97-3e34-43d0-81e5-f697f8c2345d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "ij"], "=", 
    RowBox[{
     SuperscriptBox["\[Gamma]", 
      RowBox[{"i", "j"}]], "-", 
     SuperscriptBox["\[Beta]", "i"], " ", 
     SuperscriptBox["\[Beta]", "j"], " ", 
     SuperscriptBox["\[Alpha]", 
      RowBox[{"-", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "1c5ef1c5-4259-43a9-b607-cfd71aa1eff7"],
 ", which is exactly what ",
 StyleBox["ADMInverse[\[Alpha], \[Beta], \[Gamma]]", "Input"],
 " in the package returns."
}], "Text",ExpressionUUID->"311eaadc-d6ca-4f84-875b-5adfe1732215"],

Cell["\<\
For Alcubierre's drive the ADM ingredients are spectacularly simple:\
\>", "Text",ExpressionUUID->"34738e23-f44d-43b6-850b-d5eedac86430"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[Beta]", "i"], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox["v", "s"], " ", 
      RowBox[{"f", "(", 
       SubscriptBox["r", "s"], ")"}]}], ",", " ", "0", ",", " ", "0"}], ")"}],
    ",", "\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
   RowBox[{"\[Alpha]", "=", "1"}], ",", "\[ThickSpace]\[ThickSpace]", 
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "j"}]]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"8693b96d-a512-4413-aed8-29d28d2a386c"],

Cell[TextData[{
 "All the warp \"weirdness\" lives in that single ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "i"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "a0321d9f-16f1-446b-8666-093b1c4b5c33"],
 " term \[LongDash] a unit-magnitude vector field along the direction of \
motion, modulated by the shape function so it switches on inside the bubble \
and off outside.  In Wolfram, the helper ",
 StyleBox["AlcubierreMetric", "Input"],
 " builds the full 4-metric symbolically:"
}], "Text",ExpressionUUID->"e87e5812-e8cb-4c27-ba3e-30ed84799969"],

Cell["\<\
g = AlcubierreMetric[{1, 1, 8}, {t, x, y, z}];   (* {v0, R, \[Sigma]} *)
MatrixForm @ g\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"7b19c31d-00a8-4050-a1c8-20eceb4cbd52"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "911c2904-a8ae-415b-8d3f-f97ea491dcf7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"det", "(", 
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], ")", "=", "1"}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",ExpressionUUID->
  "0cad6618-e2d4-4120-b25b-aee4a8b44b76"],
 " the formula above gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"det", "(", 
    SubscriptBox["g", 
     RowBox[{"\[Mu]", "\[Nu]"}]], ")", "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "8efb43e5-ca74-41d6-ac90-a9c24c5b0d30"],
 " everywhere, and Wolfram simplifies ",
 StyleBox["Det[g]", "Input"],
 " back to that exact value:"
}], "Text",ExpressionUUID->"3aeeda81-ee25-4af9-ae6b-7cf29c38ac3b"],

Cell["\<\
Simplify @ Det @ AlcubierreMetric[{v, R, s}, {t, x, y, z}]
(* -> -1 *)\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"7f2fc0b0-0daa-4e81-ab78-6f2400491edc"],

Cell["3. Einstein tensor in three lines", "Section",ExpressionUUID->"ce3fc4d8-52aa-49ea-947f-c00242907a7b"],

Cell[TextData[{
 "This is where Wolfram earns its keep.  In the Python port we built \
finite-difference Christoffel symbols, then finite-difference Riemann \
tensors, then finite-difference Ricci, all ~500 lines.  In Wolfram the \
equivalent is a literal transliteration of the textbook formula because ",
 StyleBox["D", "Input"],
 " differentiates symbolically.  Recall the Christoffel symbols of the second \
kind:"
}], "Text",ExpressionUUID->"3266595e-c758-4b6c-9c87-713ec1556668"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{"\[Alpha]", "\[Beta]"}], "\[Mu]"], "=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox["g", 
     RowBox[{"\[Mu]", "\[Nu]"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Alpha]"], " ", 
       SubscriptBox["g", 
        RowBox[{"\[Beta]", "\[Nu]"}]]}], "+", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Beta]"], " ", 
       SubscriptBox["g", 
        RowBox[{"\[Alpha]", "\[Nu]"}]]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
       SubscriptBox["g", 
        RowBox[{"\[Alpha]", "\[Beta]"}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"bedb1472-a3f9-49e2-aa3c-30c9957a9cb8"],

Cell["In Wolfram this is one Table loop:", "Text",ExpressionUUID->"c9256135-2930-4d2c-b771-3225d899544c"],

Cell["\<\
ChristoffelSymbols[g_, {t_, x_, y_, z_}] := Module[
  {ginv = Inverse[g],
   dg = Table[D[g, c], {c, {t, x, y, z}}]},
  Table[
    (1/2) Sum[ginv[[m, n]] (dg[[a, b, n]] + dg[[b, a, n]] - dg[[n, a, b]]),
              {n, 4}],
    {m, 4}, {a, 4}, {b, 4}]];\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"a12b284c-e950-452d-837f-16bb0b4a7b08"],

Cell["\<\
The Riemann tensor follows from the standard non-commutativity of covariant \
derivatives,\
\>", "Text",ExpressionUUID->"1b65aa8d-4b13-4758-8311-f1346752a734"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["R", 
    RowBox[{"\[Sigma]", "\[Mu]", "\[Nu]"}], "\[Rho]"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", "\[Sigma]"}], "\[Rho]"]}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Mu]", "\[Sigma]"}], "\[Rho]"]}], "+", 
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Mu]", "\[Lambda]"}], "\[Rho]"], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", "\[Sigma]"}], "\[Lambda]"]}], "-", 
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", "\[Lambda]"}], "\[Rho]"], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Mu]", "\[Sigma]"}], "\[Lambda]"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"28fc80fb-dc4a-418d-b65d-fe89dd0b6586"],

Cell["\<\
and Ricci is a single contraction, the Ricci scalar a second one:\
\>", "Text",ExpressionUUID->"6267bbc9-04a9-45fd-8293-e7bead4bc49c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["R", 
    RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
   SubsuperscriptBox["R", 
    RowBox[{"\[Mu]", "\[Rho]", "\[Nu]"}], "\[Rho]"], ",", 
   "\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
   RowBox[{"R", "=", 
    RowBox[{
     SuperscriptBox["g", 
      RowBox[{"\[Mu]", "\[Nu]"}]], " ", 
     SubscriptBox["R", 
      RowBox[{"\[Mu]", "\[Nu]"}]]}]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"bf4a6ab6-7bb3-4ddb-998e-06284d24877c"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "9e977f4c-7ad9-4b4a-b453-ff7f42064c38"],
 " denoting partial differentiation with respect to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "12ae420b-2402-4229-9ea0-f4d97917d1e1"],
 " and the usual Einstein summation convention.  The Einstein tensor is then \
a one-line definition:"
}], "Text",ExpressionUUID->"0cd092bb-847b-4619-bfdd-dff48e6e0867"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", 
    RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"\[Mu]", "\[Nu]"}]], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SubscriptBox["g", 
      RowBox[{"\[Mu]", "\[Nu]"}]], " ", "R"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"329d4ecc-ed6f-483c-890c-e636e419434d"],

Cell["Through the field equation", "Text",ExpressionUUID->"b1afde96-ea06-43c3-82d4-3595d692daaf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", 
    RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
   RowBox[{"8", "\[Pi]", " ", 
    SubscriptBox["T", 
     RowBox[{"\[Mu]", "\[Nu]"}]]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"e8c29598-a46e-4866-8217-b995110e4768"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "=", "c", "=", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "995d1fd4-8020-4d1c-9863-a63d154ee3a7"],
 ", we read off the matter content the metric implies:"
}], "Text",ExpressionUUID->"1ce3815b-6a72-4ecb-b891-80347e35c920"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["T", 
    RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
   FractionBox[
    SubscriptBox["G", 
     RowBox[{"\[Mu]", "\[Nu]"}]], 
    RowBox[{"8", "\[Pi]"}]]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"3a9af080-2f9b-41a2-850f-6837f8594061"],

Cell["\<\
In Wolfram that's a one-liner.  At a point on the bubble wall:\
\>", "Text",ExpressionUUID->"bc791b20-4736-4776-92f0-6b2a723bfe9f"],

Cell["\<\
GAt = EinsteinTensor[g, {t, x, y, z}] /.
       {t -> 0, x -> 1.0, y -> 0.2, z -> 0};
N @ Chop @ GAt // MatrixForm
(*  GAt[[1,1]] = 8 Pi T_{00} -- the energy density measured by a
    *static* coordinate observer (4-velocity (1,0,0,0)).  This is
    NOT the Eulerian-observer energy density rho_Eulerian =
    T_{mu nu} n^mu n^nu, which is contracted with the unit normal
    n = (1, -beta^i)/alpha and is computed by EulerianEnergyDensity.
    The (0,i) entries are momentum density components and the
    ij-block is anisotropic stress.  *)\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"e5c4cde6-547b-4812-b1a9-300ee50baff6"],

Cell["\<\
For Alcubierre the energy density seen by an Eulerian (slice-normal) observer \
admits a famous closed form, derived by Alcubierre in the original paper:\
\>", "Text",ExpressionUUID->"ca5779b2-254d-41ab-a6e2-db15996eaa2c"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Rho]", "=", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      SubscriptBox["v", "s"], "2"], 
     RowBox[{"32", "\[Pi]"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["df", 
       RowBox[{"d", 
        SubscriptBox["r", "s"]}]], ")"}], "2"], " ", 
    FractionBox[
     RowBox[{
      SuperscriptBox["y", "2"], "+", 
      SuperscriptBox["z", "2"]}], 
     SuperscriptBox[
      SubscriptBox["r", "s"], "2"]]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"ab6ec236-5bb8-48c4-8acd-21f538c1e178"],

Cell[TextData[{
 "Plotted in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "678528b7-a72c-4a29-a910-62ceef1833a2"],
 " plane it's strikingly anisotropic \[LongDash] zero on the \
direction-of-motion axis, peaking in two crescent-shaped regions in the \
bubble wall.  Note the colour scale: the values are ",
 StyleBox["negative everywhere",
  FontSlant->Italic],
 " they are non-zero.  This is the punchline of the original 1994 paper:"
}], "Text",ExpressionUUID->"f7663e93-51ca-40c6-a347-e7ae4fd5fb95"],

Cell["\<\
DensityPlot[
  AlcubierreAnalyticEnergyDensity[{1, 1, 8}, {0, x, y, 0}],
  {x, -2.5, 2.5}, {y, -2.5, 2.5},
  PlotPoints -> 220, ColorFunction -> \"TemperatureMap\",
  PlotLegends -> Automatic,
  Epilog -> {Black, Thick, Circle[{0, 0}, 1]}]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"3f7882a7-fa43-449d-afec-dc24e46be31e"],

