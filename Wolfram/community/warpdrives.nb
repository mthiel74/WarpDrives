Cell[TextData[{
 "Each profile satisfies the same boundary conditions \[LongDash] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "0", ")", "=", "1"}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",ExpressionUUID->
  "7f30e802-a8e1-4337-9957-3c2dcb7ef668"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "\[Infinity]", ")", "=", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "3ec1839b-0957-481f-a941-95061b8f18e2"],
 " \[LongDash] but they differ in how sharp the wall is and whether the \
support is compact.  Sharper walls localise the exotic matter into a thinner \
shell at the cost of larger derivatives, which means more curvature, which \
means more energy.  This is the first hint that the energy bill of a warp \
drive is essentially set by the ",
 StyleBox["geometry of the wall",
  FontSlant->Italic],
 ", not by the bubble's velocity."
}], "Text",ExpressionUUID->"758bfe60-18f8-4cda-8b67-92630e98974d"],

Cell["2. The metric in ADM form", "Section",ExpressionUUID->"f7f823ff-466f-42b6-b2b0-3e8439427af4"],

Cell[TextData[{
 "Every warp drive in the literature is most natural in the 3+1 ADM \
formulation.  Foliate spacetime into spatial slices labelled by ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "efcde49a-762f-4051-bcd5-4326b1afd8c7"],
 "; on each slice keep the spatial metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "1f70865d-9021-422a-b0de-6bd8a90ca3d8"],
 "; relate proper time on neighbouring slices by the lapse ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "a1869242-19e5-4519-89e2-87c3b45bc4a6"],
 "; relate spatial coordinates between slices by the shift vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "i"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "1232275e-3342-42e6-99cb-d0662671b77a"],
 ".  The line element splits into a temporal-distance piece and a \
spatial-displacement piece:"
}], "Text",ExpressionUUID->"fdc93341-804f-49b6-ae63-fd00b2db17ab"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["ds", "2"], "=", 
   RowBox[{"-", 
    SuperscriptBox["\[Alpha]", "2"], " ", 
    SuperscriptBox["dt", "2"]}], "+", 
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["dx", "i"], "+", 
     RowBox[{
      SuperscriptBox["\[Beta]", "i"], "dt"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["dx", "j"], "+", 
     RowBox[{
      SuperscriptBox["\[Beta]", "j"], "dt"}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"69e0b27e-f789-4b18-9748-4aef6c7b8fe2"],

Cell["\<\
Reading off matrix entries gives the standard 3+1 decomposition of the \
4-metric:\
\>", "Text",ExpressionUUID->"33c4f1bb-aaf7-4bdd-a4e2-7adef60217c8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", "00"], "=", 
   RowBox[{"-", 
    SuperscriptBox["\[Alpha]", "2"], "+", 
    RowBox[{
     SubscriptBox["\[Beta]", "i"], " ", 
     SuperscriptBox["\[Beta]", "i"]}]}]}], TraditionalForm]], "DisplayFormula",\

 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"33358bfa-5d11-4ff8-b666-461a1ef882c8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"0", "i"}]], "=", 
   SubscriptBox["\[Beta]", "i"], "=", 
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], " ", 
    SuperscriptBox["\[Beta]", "j"]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"69c286ce-d8c0-4f35-b924-727a84d9f2a5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", "ij"], "=", 
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"9f784e9b-3f02-4526-ac1f-78882a26701f"],

Cell[TextData[{
 "with summation convention on the spatial indices ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ",", "j", "\[Element]", 
    RowBox[{"{", "1", ",", "2", ",", "3", "}"}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "2f5c7651-6809-47ed-a179-79031096326e"],
 " and the spatial-metric raise/lower ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "i"], "=", 
    RowBox[{
     SubscriptBox["\[Gamma]", 
      RowBox[{"i", "j"}]], " ", 
     SuperscriptBox["\[Beta]", "j"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "8b7d9fc2-26c5-4371-a07d-e7d00036567e"],
 ".  The inverse 4-metric has a similarly clean form: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "00"], "=", 
    RowBox[{"-", 
     SuperscriptBox["\[Alpha]", 
      RowBox[{"-", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "0b9b4714-4cdc-47e9-a934-637885b8de63"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"0", "i"}]], "=", 
    RowBox[{
     SuperscriptBox["\[Beta]", "i"], 
     SuperscriptBox["\[Alpha]", 
      RowBox[{"-", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "305e5733-d15f-4138-bc10-c62504ccb380"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "ij"], "=", 
    RowBox[{
     SuperscriptBox["\[Gamma]", 
      RowBox[{"i", "j"}]], "-", 
     SuperscriptBox["\[Beta]", "i"], " ", 
     SuperscriptBox["\[Beta]", "j"], " ", 
     SuperscriptBox["\[Alpha]", 
      RowBox[{"-", "2"}]]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "de663adc-4a8c-44dc-bd74-8751a32ea55a"],
 ", which is exactly what ",
 StyleBox["ADMInverse[\[Alpha], \[Beta], \[Gamma]]", "Input"],
 " in the package returns."
}], "Text",ExpressionUUID->"c0ee149a-58de-487a-800f-e8daa8de6b87"],

Cell["\<\
For Alcubierre's drive the ADM ingredients are spectacularly simple:\
\>", "Text",ExpressionUUID->"681f3ef1-c6e6-482c-962d-8341aac422da"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[Beta]", "i"], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox["v", "s"], " ", 
      RowBox[{"f", "(", 
       SubscriptBox["r", "s"], ")"}]}], ",", " ", "0", ",", " ", "0"}], ")"}],
    ",", "\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
   RowBox[{"\[Alpha]", "=", "1"}], ",", "\[ThickSpace]\[ThickSpace]", 
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "j"}]]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"9580710a-5462-45ac-897c-e2f438f48330"],

Cell[TextData[{
 "All the warp \"weirdness\" lives in that single ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "i"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "e89f8278-8d2a-427a-a8df-1c3da51146f7"],
 " term \[LongDash] a unit-magnitude vector field along the direction of \
motion, modulated by the shape function so it switches on inside the bubble \
and off outside.  In Wolfram, the helper ",
 StyleBox["AlcubierreMetric", "Input"],
 " builds the full 4-metric symbolically:"
}], "Text",ExpressionUUID->"aabb5d3e-2c65-4981-a3f9-d37f3f89e09b"],

Cell["\<\
g = AlcubierreMetric[{1, 1, 8}, {t, x, y, z}];   (* {v0, R, \[Sigma]} *)
MatrixForm @ g\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"c2a5fc76-8a7e-40f3-ba02-e8a724da0aaf"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "8170f1f8-aec7-49cd-ae4d-57396060fd7f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"det", "(", 
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], ")", "=", "1"}], TraditionalForm]], "InlineFormula",
  
  FontFamily->"Times",ExpressionUUID->
  "f6065980-17ab-461a-b3d2-54f6bfa0e522"],
 " the formula above gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"det", "(", 
    SubscriptBox["g", 
     RowBox[{"\[Mu]", "\[Nu]"}]], ")", "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "973c52a7-9b5b-4639-9af8-57a9701fd62c"],
 " everywhere, and Wolfram simplifies ",
 StyleBox["Det[g]", "Input"],
 " back to that exact value:"
}], "Text",ExpressionUUID->"9bbca7ae-e3a3-48b9-97cd-6682d170aa3c"],

Cell["\<\
Simplify @ Det @ AlcubierreMetric[{v, R, s}, {t, x, y, z}]
(* -> -1 *)\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"4142566a-7572-415e-9d78-81746ff55eab"],

Cell["3. Einstein tensor in three lines", "Section",ExpressionUUID->"4676085f-6afb-40d6-92c1-1366ae37f148"],

Cell[TextData[{
 "This is where Wolfram earns its keep.  In the Python port we built \
finite-difference Christoffel symbols, then finite-difference Riemann \
tensors, then finite-difference Ricci, all ~500 lines.  In Wolfram the \
equivalent is a literal transliteration of the textbook formula because ",
 StyleBox["D", "Input"],
 " differentiates symbolically.  Recall the Christoffel symbols of the second \
kind:"
}], "Text",ExpressionUUID->"365d1955-d5ac-4842-8966-43630df4ce33"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{"\[Alpha]", "\[Beta]"}], "\[Mu]"], "=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox["g", 
     RowBox[{"\[Mu]", "\[Nu]"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Alpha]"], " ", 
       SubscriptBox["g", 
        RowBox[{"\[Beta]", "\[Nu]"}]]}], "+", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Beta]"], " ", 
       SubscriptBox["g", 
        RowBox[{"\[Alpha]", "\[Nu]"}]]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
       SubscriptBox["g", 
        RowBox[{"\[Alpha]", "\[Beta]"}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"c489059d-a341-41f7-99eb-d231c5723674"],

Cell["In Wolfram this is one Table loop:", "Text",ExpressionUUID->"b051d1bc-5425-4f94-994a-c31397e1c53e"],

Cell["\<\
ChristoffelSymbols[g_, {t_, x_, y_, z_}] := Module[
  {ginv = Inverse[g],
   dg = Table[D[g, c], {c, {t, x, y, z}}]},
  Table[
    (1/2) Sum[ginv[[m, n]] (dg[[a, b, n]] + dg[[b, a, n]] - dg[[n, a, b]]),
              {n, 4}],
    {m, 4}, {a, 4}, {b, 4}]];\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"3ec2eb3d-4170-4271-8c3e-19ee29240d70"],

Cell["\<\
The Riemann tensor follows from the standard non-commutativity of covariant \
derivatives,\
\>", "Text",ExpressionUUID->"f9b9446f-1602-4b7f-b713-33c3a3758106"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["R", 
    RowBox[{"\[Sigma]", "\[Mu]", "\[Nu]"}], "\[Rho]"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", "\[Sigma]"}], "\[Rho]"]}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Mu]", "\[Sigma]"}], "\[Rho]"]}], "+", 
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Mu]", "\[Lambda]"}], "\[Rho]"], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", "\[Sigma]"}], "\[Lambda]"]}], "-", 
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Nu]", "\[Lambda]"}], "\[Rho]"], " ", 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"\[Mu]", "\[Sigma]"}], "\[Lambda]"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"01d85b6e-a98f-4055-8351-9485c48b306b"],

Cell["\<\
and Ricci is a single contraction, the Ricci scalar a second one:\
\>", "Text",ExpressionUUID->"cac1ac8c-132f-4ec6-8198-b5ab22666a85"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["R", 
    RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
   SubsuperscriptBox["R", 
    RowBox[{"\[Mu]", "\[Rho]", "\[Nu]"}], "\[Rho]"], ",", 
   "\[ThickSpace]\[ThickSpace]\[ThickSpace]", 
   RowBox[{"R", "=", 
    RowBox[{
     SuperscriptBox["g", 
      RowBox[{"\[Mu]", "\[Nu]"}]], " ", 
     SubscriptBox["R", 
      RowBox[{"\[Mu]", "\[Nu]"}]]}]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"ee9fe2cf-26ca-4566-ac35-d8a282072cf4"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "1c73098f-a7d7-48b2-ba85-f3572f0c0743"],
 " denoting partial differentiation with respect to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[Mu]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "8e078c98-d744-42c6-bd41-21a0649c612b"],
 " and the usual Einstein summation convention.  The Einstein tensor is then \
a one-line definition:"
}], "Text",ExpressionUUID->"1b2bd561-38ca-428e-85f5-6698aa8646cc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", 
    RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"\[Mu]", "\[Nu]"}]], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SubscriptBox["g", 
      RowBox[{"\[Mu]", "\[Nu]"}]], " ", "R"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"f3cc671d-836e-4f54-a73f-cc785cd6b49c"],

Cell["Through the field equation", "Text",ExpressionUUID->"7586b283-3450-469a-8028-e8f10d559fff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", 
    RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
   RowBox[{"8", "\[Pi]", " ", 
    SubscriptBox["T", 
     RowBox[{"\[Mu]", "\[Nu]"}]]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"7f4a52fb-602f-469c-bd27-789fd7a8dd5e"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "=", "c", "=", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "cb747b02-1d21-43aa-b281-bea65bab9623"],
 ", we read off the matter content the metric implies:"
}], "Text",ExpressionUUID->"931749d3-22df-48c8-9bca-c6bece252e9c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["T", 
    RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
   FractionBox[
    SubscriptBox["G", 
     RowBox[{"\[Mu]", "\[Nu]"}]], 
    RowBox[{"8", "\[Pi]"}]]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"3f87d2bb-aa4b-47a3-be3d-b07b53c27e60"],

Cell["\<\
In Wolfram that's a one-liner.  At a point on the bubble wall:\
\>", "Text",ExpressionUUID->"6fbdf8e4-c13d-4875-9d34-f5d92db7ce0a"],

Cell["\<\
GAt = EinsteinTensor[g, {t, x, y, z}] /.
       {t -> 0, x -> 1.0, y -> 0.2, z -> 0};
N @ Chop @ GAt // MatrixForm
(*  GAt[[1,1]] = 8 Pi T_{00} -- the energy density measured by a
    *static* coordinate observer (4-velocity (1,0,0,0)).  This is
    NOT the Eulerian-observer energy density rho_Eulerian =
    T_{mu nu} n^mu n^nu, which is contracted with the unit normal
    n = (1, -beta^i)/alpha and is computed by EulerianEnergyDensity.
    The (0,i) entries are momentum density components and the
    ij-block is anisotropic stress.  *)\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"337bc15f-72c5-45aa-be4f-9a2d1f31b918"],

Cell[TextData[{
 "For Alcubierre the energy density seen by an Eulerian (slice-normal) \
observer admits a famous closed form, derived by Alcubierre in the original \
paper (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["y", "2"], "+", 
    SuperscriptBox["z", "2"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "39dbcea6-9520-405c-a5e0-2854e9233f44"],
 " is the squared transverse distance from the bubble's direction-of-motion \
axis):"
}], "Text",ExpressionUUID->"c9a2224d-a7a7-428e-a726-d96c0b9cbc03"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Rho]", "=", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      SubscriptBox["v", "s"], "2"], 
     RowBox[{"32", "\[Pi]"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["df", 
       RowBox[{"d", 
        SubscriptBox["r", "s"]}]], ")"}], "2"], " ", 
    FractionBox[
     RowBox[{
      SuperscriptBox["y", "2"], "+", 
      SuperscriptBox["z", "2"]}], 
     SuperscriptBox[
      SubscriptBox["r", "s"], "2"]]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"9e9e52b7-9b6b-461e-b805-a3387579a912"],

Cell[TextData[{
 "Plotted in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "8a220e62-2da7-4c08-92a8-519fc2680c15"],
 " plane it's strikingly anisotropic \[LongDash] zero on the \
direction-of-motion axis, peaking in two crescent-shaped regions in the \
bubble wall.  Note the colour scale: the values are ",
 StyleBox["negative everywhere",
  FontSlant->Italic],
 " they are non-zero.  This is the punchline of the original 1994 paper:"
}], "Text",ExpressionUUID->"8740da7b-1b50-4d63-98ca-b58a74ef62be"],

Cell["\<\
DensityPlot[
  AlcubierreAnalyticEnergyDensity[{1, 1, 8}, {0, x, y, 0}],
  {x, -2.5, 2.5}, {y, -2.5, 2.5},
  PlotPoints -> 220, ColorFunction -> \"TemperatureMap\",
  PlotLegends -> Automatic,
  Epilog -> {Black, Thick, Circle[{0, 0}, 1]}]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"ae5c13ad-4568-4997-b8c4-e107db2909b6"],

