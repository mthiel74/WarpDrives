Notebook[{
Cell["Warp Drives in the Wolfram Language", "Title",ExpressionUUID->"49ad6b35-8bd3-47d8-9d14-11a81e0674ce"],

Cell["\<\
A symbolic-tensor playground for general-relativistic warp bubbles \
\[LongDash] from the Alcubierre metric to subluminal Bobrick\[Dash]Martire \
shells, with native Einstein tensors, geodesics, and animated spacetime \
distortions.\
\>", "Subtitle",ExpressionUUID->"8eefe262-d0b9-4d36-8a0a-c7e9f77d9e5d"],

Cell[TextData[{
 "Marco Thiel, April 2026 \[LongDash] ",
 ButtonBox["github.com/mthiel74/WarpDrives",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/WarpDrives"], None}]
}], "Text",
 TextAlignment->Center,
 FontSlant->Italic,ExpressionUUID->"7aabaa4c-42a9-4f79-9524-6d14117892de"],

