 TextAlignment->Center,ExpressionUUID->"e3532724-d165-4982-b17e-777c56f3b468"],

Cell[TextData[{
 "The same energy density rendered as a 3D surface brings out the wall \
structure.  Figure 1 is a live ",
 StyleBox["Plot3D", "Input"],
 " output cell, so in Mathematica or Wolfram Player you can click-and-drag to \
rotate the surface (the browser preview shows a default viewpoint)."
}], "Text",ExpressionUUID->"dc5fbb8b-aa2a-49b5-9335-9a6fdf578e21"],

Cell["\<\
Plot3D[
  AlcubierreAnalyticEnergyDensity[{1, 1, 8}, {0, x, y, 0}],
  {x, -1.8, 1.8}, {y, -1.8, 1.8},
  PlotPoints -> 60, MaxRecursion -> 1, Mesh -> None,
  ColorFunction -> Function[{x, y, z},
    ColorData[\"TemperatureMap\"][Rescale[z, {-0.00006, 0}]]],
  ColorFunctionScaling -> False,
  Lighting -> \"Neutral\", Boxed -> False, Axes -> False,
  BoxRatios -> {1, 1, 0.55}, ImageSize -> 600,
  PlotLabel -> Style[\"Eulerian \[Rho](x, y, 0) -- v=c, R=1, \[Sigma]=8\",
                     Bold, 13]]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"9950e4cb-fa07-4554-85fb-2af39c923cb2"],

