 ShowCellLabel->False,
 TextAlignment->Center,ExpressionUUID->"04cde244-9175-4dd3-b9d8-7fa45da40f35"],

Cell["4. Where space contracts, where space expands", "Section",ExpressionUUID->"ae7c6e70-dd7c-4e1c-8f46-39ddc2850fe5"],

Cell[TextData[{
 "What does \"contraction in front, expansion behind\" mean operationally?  \
The ADM expansion scalar of the Eulerian observers measures it directly.  An \
Eulerian observer is one that moves with the spatial slices \[LongDash] their \
4-velocity is the unit normal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["n", "\[Mu]"], "=", 
    RowBox[{
     SuperscriptBox["\[Alpha]", 
      RowBox[{"-", "1"}]], 
     RowBox[{"(", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", 
        SuperscriptBox["\[Beta]", "i"]}]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "fe2a6f90-f0f1-4e94-aec8-847b19020499"],
 ".  The extrinsic curvature of the slice measures how it bends inside \
spacetime as time flows:"
}], "Text",ExpressionUUID->"fae7ef85-8bb2-4ea5-8c18-380e54e46126"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["K", 
    RowBox[{"i", "j"}]], "=", 
   RowBox[{"-", 
    FractionBox["1", 
     RowBox[{"2", "\[Alpha]"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["D", "i"], " ", 
       SubscriptBox["\[Beta]", "j"]}], "+", 
      RowBox[{
       SubscriptBox["D", "j"], " ", 
       SubscriptBox["\[Beta]", "i"]}], "-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], " ", 
       SubscriptBox["\[Gamma]", 
        RowBox[{"i", "j"}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"ed7c5016-1fec-4f1a-ad4b-f812a93bc007"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "i"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "88c0e7c8-bb3d-4dee-b1d7-06d07d01aafe"],
 " the spatial covariant derivative on the slice (compatible with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "j"}]], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "55ce86ab-1678-48cf-8f18-316f40cbbd22"],
 ").  Its trace is the volume expansion rate seen by Eulerian observers:"
}], "Text",ExpressionUUID->"0f528d81-7ee8-416a-96bb-e665cf6b6662"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Theta]", "=", 
   RowBox[{
    SuperscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], " ", 
    SubscriptBox["K", 
     RowBox[{"i", "j"}]]}], "=", 
   RowBox[{"-", 
    SubscriptBox["D", "i"], " ", 
    SuperscriptBox["\[Beta]", "i"]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"13d9a3d8-c0c4-45f5-8597-4abb4c0803ea"],

Cell[TextData[{
 "For Alcubierre's metric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "c7f1d8cf-163b-4839-8149-cca023b0c638"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"i", "j"}]], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "j"}]]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "44729d6c-d73c-401c-873e-2c7498e03162"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "i"], " ", 
    SuperscriptBox["\[Beta]", "i"], "=", 
    RowBox[{
     SubscriptBox["\[PartialD]", "i"], " ", 
     SuperscriptBox["\[Beta]", "i"]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "efe9ccdd-ac06-4528-911e-6f66f5c79b43"],
 " is just the ordinary divergence.  Plugging in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Beta]", "x"], "=", 
    RowBox[{"-", 
     SubscriptBox["v", "s"], " ", 
     RowBox[{"f", "(", 
      SubscriptBox["r", "s"], ")"}]}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "57f559b1-1301-4280-b3d4-05451583d6d5"],
 " and using the chain rule one gets a strikingly clean closed form:"
}], "Text",ExpressionUUID->"4041c324-083b-466f-8f31-f50605fb0e30"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Theta]", "=", 
   RowBox[{"-", "\[Del]", "\[CenterDot]", "\[Beta]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox["v", "s"], "(", 
      RowBox[{"x", "-", 
       SubscriptBox["x", "s"]}], ")"}], 
     SubscriptBox["r", "s"]], " ", 
    FractionBox["df", 
     RowBox[{"d", 
      SubscriptBox["r", "s"]}]]}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"66478da0-a606-414f-9230-975e63005731"],

Cell[TextData[{
 "For Alcubierre's bubble it's antisymmetric in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "-", 
    SubscriptBox["x", "s"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "c0dd1883-2339-4994-94bd-39749775554c"],
 ": positive (volume expansion) behind the bubble, negative (volume \
contraction) in front, zero on the y-z plane through the centre.  Plotted on \
a slice at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "0"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "5fc18996-77a5-4e23-9128-01625d739595"],
 " using a divergent colourmap:"
}], "Text",ExpressionUUID->"08891a70-93ee-4b82-9302-4313ff65c625"],

Cell["\<\
DensityPlot[
  AlcubierreExpansionScalar[{1, 1, 8}, {0, x, y, 0}],
  {x, -2.5, 2.5}, {y, -2.5, 2.5},
  PlotPoints -> 220, ColorFunction -> \"RedBlueTones\",
  PlotLegends -> Automatic,
  Epilog -> {Black, Thick, Circle[{0, 0}, 1]}]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"eec523df-b872-4b7f-b785-8500cb7ea048"],

